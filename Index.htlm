<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIM Internet Express - Inscription</title>
    <style>
        :root {
            --orange: #FF6600;
            --dark: #111111;
            --gray-bg: #F4F5F7;
            --light: #FFFFFF;
            --success: #28A745;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--gray-bg);
            color: var(--dark);
            padding: 20px 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card-container {
            background: var(--light);
            border-radius: 16px;
            padding: 25px 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 480px;
        }

        .header-logo {
            text-align: center;
            margin-bottom: 20px;
        }

        .header-logo h1 {
            font-size: 1.5rem;
            color: var(--dark);
            text-transform: uppercase;
        }

        .header-logo span {
            color: var(--orange);
        }

        .header-logo p {
            font-size: 0.85rem;
            color: #666;
            margin-top: 5px;
        }

        .form-group {
            margin-bottom: 14px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #333;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border: 1px solid #DDD;
            border-radius: 10px;
            font-size: 0.95rem;
            background: #FAFAFA;
            outline: none;
            transition: border 0.2s;
        }

        input:focus, select:focus {
            border-color: var(--orange);
            background: #FFF;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .btn-submit {
            background: var(--orange);
            color: white;
            border: none;
            width: 100%;
            padding: 16px;
            font-size: 1.05rem;
            font-weight: bold;
            border-radius: 10px;
            margin-top: 15px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(255, 102, 0, 0.3);
        }

        .btn-submit:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>

    <div class="card-container">
        <div class="header-logo">
            <h1>⚡ SIM <span>EXPRESS</span></h1>
            <p>Créer votre compte pour commander vos puces internet</p>
        </div>

        <form id="signupForm" onsubmit="saveUserAccount(event)">
            <div class="form-group">
                <label>Nom complet *</label>
                <input type="text" id="fullname" placeholder="Ex: Franck Tiodjio" required>
            </div>

            <div class="form-group">
                <label>Adresse Email *</label>
                <input type="email" id="email" placeholder="nom@exemple.com" required>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Mot de passe *</label>
                    <input type="password" id="password" placeholder="••••••••" required>
                </div>
                <div class="form-group">
                    <label>Date de naissance *</label>
                    <input type="date" id="dob" required>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Ville *</label>
                    <select id="city" onchange="loadNeighborhoods()" required>
                        <option value="Douala">Douala</option>
                        <option value="Yaounde">Yaoundé</option>
                        <option value="Autre">Autre Ville</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quartier *</label>
                    <select id="neighborhood" required></select>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Numéro WhatsApp *</label>
                    <input type="tel" id="whatsapp" placeholder="6XXXXXXXX" required>
                </div>
                <div class="form-group">
                    <label>Appel Urgence *</label>
                    <input type="tel" id="phone" placeholder="6XXXXXXXX" required>
                </div>
            </div>

            <button type="submit" class="btn-submit">S'INSCRIRE ET CONTINUER ➔</button>
        </form>
    </div>

    <script>
        const neighborhoods = {
            "Douala": ["Bonabéri", "Akwa", "Bonapriso", "Bonamoussadi", "Makepe", "Ndokoti", "Bepanda", "Logbessou", "Kotto", "Yassa", "Nyalla", "Village", "Bali"],
            "Yaounde": ["Mvog-Mbi", "Bastos", "Mendong", "Biyem-Assi", "Omnisports", "Essos", "Mvan", "Nsam", "Melen", "Ngoa-Ekelle", "Tsinga", "Odza", "Etoudi"],
            "Autre": ["Autre Quartier / Hors zone"]
        };

        function loadNeighborhoods() {
            const city = document.getElementById("city").value;
            const select = document.getElementById("neighborhood");
            select.innerHTML = "";
            
            neighborhoods[city].forEach(q => {
                select.innerHTML += `<option value="${q}">${q}</option>`;
            });
        }

        function saveUserAccount(event) {
            event.preventDefault();

            // Structure du profil client
            const userData = {
                fullname: document.getElementById("fullname").value.trim(),
                email: document.getElementById("email").value.trim(),
                password: document.getElementById("password").value,
                dob: document.getElementById("dob").value,
                city: document.getElementById("city").value,
                neighborhood: document.getElementById("neighborhood").value,
                whatsapp: document.getElementById("whatsapp").value.trim(),
                phone: document.getElementById("phone").value.trim()
            };

            // Sauvegarde dans le téléphone du client
            localStorage.setItem("userProfile", JSON.stringify(userData));

            alert("Compte créé avec succès ! Redirection vers le catalogue...");
            
            // Redirection vers la future page catalogue
            window.location.href = "catalogue.html";
        }

        // Chargement initial des quartiers
        loadNeighborhoods();
    </script>
</body>
</html>
